{
  "name": "embodied-intelligence-course-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "generate:api": "node scripts/generate-api.mjs",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "build": "npm run generate:api && npm run typecheck && vite build",
    "build:e2e": "npm run generate:api && npm run typecheck && vite build --mode e2e",
    "preview": "vite preview",
    "test:e2e": "npm run build:e2e && node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "three": "0.180.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-vue": "6.0.8",
    "openapi-typescript": "7.13.0",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vue-tsc": "3.3.8"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.0",
      "minimatch": "10.2.5"
    }
  }
}
